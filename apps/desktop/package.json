{
  "name": "quantlabs-desktop",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron . --dev",
    "test:desktop": "node --test electron/runtime.test.cjs electron/launcher.test.cjs && node --experimental-strip-types --test electron/variables.test.ts electron/countries.test.ts electron/flowUi.test.ts electron/regressions.test.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@xyflow/react": "12.12.0",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "main": "electron/main.cjs"
}
