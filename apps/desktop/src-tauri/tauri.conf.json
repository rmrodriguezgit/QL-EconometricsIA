{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quantlabs Econometrics",
  "version": "0.5.4",
  "identifier": "com.quantlabs.econometrics",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quantlabs · Econometrics",
        "width": 1440,
        "height": 1000,
        "minWidth": 800,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
