  "lesson": {
    "module": "DL02",
    "title": "Red multicapa para clasificación frente a logit",
    "objective": "Definir una red multicapa con salida sigmoide para una clase binaria y compararla con un logit cuando el verdadero modelo es logístico.",
    "references": [
      "B06",
      "B09"
    ],
    "steps": [
      {
        "node_id": "datos",
        "title": "1. Datos binarios",
        "instruction": "Genera una clase 0/1 con P(clase = 1) = Λ(−0,4 + 1,2·x).",
        "expected": "800 filas con x y clase.",
        "question": "¿Qué forma tiene la probabilidad verdadera?"
      },
      {
        "node_id": "particion",
        "title": "2. Entrenamiento y prueba",
        "instruction": "Separa 75 % y 25 %.",
        "expected": "600 y 200 filas.",
        "question": "¿Están equilibradas las clases?"
      },
      {
        "node_id": "entrada",
        "title": "3. Capa de entrada",
        "instruction": "Una neurona por variable (x), estandarizada.",
        "expected": "Arquitectura con 1 entrada.",
        "question": "¿Qué pasaría sin estandarizar?"
      },
      {
        "node_id": "capa_1",
        "title": "4. Capa oculta 1",
        "instruction": "Densa de 8 neuronas ReLU.",
        "expected": "16 parámetros.",
        "question": "¿Hace falta tanta capacidad para un logit?"
      },
      {
        "node_id": "capa_2",
        "title": "5. Capa oculta 2",
        "instruction": "Densa de 4 neuronas ReLU.",
        "expected": "36 parámetros.",
        "question": "¿Qué riesgo trae añadir capas?"
      },
      {
        "node_id": "salida",
        "title": "6. Capa de salida",
        "instruction": "Una neurona sigmoide para la clase; pérdida de entropía cruzada.",
        "expected": "Salida entre 0 y 1.",
        "question": "¿Por qué sigmoide y no lineal?"
      },
      {
        "node_id": "entrenar",
        "title": "7. Entrenar",
        "instruction": "Adam con parada temprana.",
        "expected": "Exactitud de ajuste y validación.",
        "question": "¿Se separan las curvas de pérdida?"
      },
      {
        "node_id": "evaluar_red",
        "title": "8. Evaluar la red",
        "instruction": "Evalúa la probabilidad predicha en la prueba.",
        "expected": "RMSE (error de Brier) de prueba.",
        "question": "¿Qué significa un RMSE de una probabilidad?"
      },
      {
        "node_id": "logit",
        "title": "9. Logit",
        "instruction": "Ajusta el logit con la misma muestra.",
        "expected": "Coeficientes cercanos a −0,4 y 1,2.",
        "question": "¿Recupera los parámetros verdaderos?"
      },
      {
        "node_id": "evaluar_logit",
        "title": "10. Evaluar el logit",
        "instruction": "Evalúa el logit en la misma prueba.",
        "expected": "Exactitud y error parecidos a los de la red.",
        "question": "¿Cuál es más interpretable?"
      },
      {
        "node_id": "reporte",
        "title": "11. Interpretar",
        "instruction": "Concluye cuál modelo usar y por qué.",
        "expected": "Conclusión que compara desempeño e interpretabilidad.",
        "question": "¿Cuándo sí valdría la pena la red?"
      }
    ],
    "missing_tools": [
      "Clasificación multiclase (softmax)",
      "Curva ROC y AUC"
    ]
  }
