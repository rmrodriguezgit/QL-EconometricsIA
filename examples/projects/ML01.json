      {
        "node_id": "datos",
        "title": "1. Datos no lineales",
        "instruction": "Genera y = sen(x) + ruido.",
        "expected": "600 filas con x e y.",
        "question": "¿Qué modelo lineal podría captar esta forma?"
      },
      {
        "node_id": "particion",
        "title": "2. Entrenamiento y prueba",
        "instruction": "Separa 75 % y 25 %.",
        "expected": "450 y 150 filas.",
        "question": "¿Por qué guardar una prueba aparte de la validación?"
      },
      {
        "node_id": "ml",
        "title": "3. Comparar modelos",
        "instruction": "Ajusta media, Ridge, ElasticNet, bosque aleatorio, boosting, SVR y KNN con el 80 % del entrenamiento y elige el de menor RMSE en el 20 % restante.",
        "expected": "Tabla con RMSE de ajuste y de validación por modelo; gana un modelo no lineal.",
        "question": "¿Cuáles tienen RMSE de ajuste mucho menor que el de validación?"
      },
      {
        "node_id": "evaluar_ml",
        "title": "4. Evaluar el elegido",
        "instruction": "Evalúa el modelo elegido en la prueba.",
        "expected": "RMSE de prueba cercano al ruido (0,1).",
        "question": "¿Se parece al RMSE de validación?"
      },
      {
        "node_id": "mco",
        "title": "5. MCO",
        "instruction": "Ajusta MCO de referencia.",
        "expected": "Una recta.",
        "question": "¿Qué parte de la variación no capta?"
      },
      {
        "node_id": "evaluar_mco",
        "title": "6. Evaluar MCO",
        "instruction": "Evalúa MCO en la misma prueba.",
        "expected": "RMSE mucho mayor.",
        "question": "¿Cuánto mejora el modelo elegido?"
      },
      {
        "node_id": "reporte",
        "title": "7. Interpretar",
        "instruction": "Concluye cuál modelo usar y por qué.",
        "expected": "Conclusión con validación, prueba y sobreajuste.",
        "question": "¿Qué ganarías y perderías frente a la red de DL01?"
