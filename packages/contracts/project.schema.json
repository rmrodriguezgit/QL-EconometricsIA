{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantlabs.local/schemas/project-1.0.0.json",
  "title": "Quantlabs project 1.0.0",
  "type": "object",
  "required": ["schema_version", "app_version", "title", "nodes", "edges"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "app_version": { "type": "string" },
    "title": { "type": "string", "maxLength": 120 },
    "nodes": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "maxItems": 400, "items": { "$ref": "#/$defs/edge" } }
  },
  "$defs": {
    "node": {
      "type": "object", "required": ["id", "type", "node_version", "parameters", "position"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "enum": ["simulate", "csv", "worldbank", "describe", "scatter", "ols"] },
        "node_version": { "const": "1.0.0" },
        "parameters": { "type": "object", "additionalProperties": { "type": ["number", "string"] } },
        "position": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } }
      }
    },
    "edge": {
      "type": "object", "required": ["id", "source", "target", "source_port", "target_port"],
      "properties": {
        "id": { "type": "string" }, "source": { "type": "string" }, "target": { "type": "string" },
        "source_port": { "type": "string" }, "target_port": { "type": "string" }
      }
    }
  }
}
