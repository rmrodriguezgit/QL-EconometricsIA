    }
   }
  },
  "time_plot": {
   "to": "series_plot",
   "params": {
    "columns": "value",
    "time": "time",
    "y_axis": "y_axis",
    "mode": {
     "value": "original"
    }
   }
  },
  "describe_table": {
   "to": "describe",
   "params": {
    "columns": "columns"
   }
  },
  "mlp": {
   "to": "nn_train",
   "chain": true,
   "params": {}
  }
 }
