    "y": "y",
    "estimator": "method",
    "folds": "folds",
    "seed": "seed",
    "cv": {
     "value": "kfold"
    }
   }
  },
  "sklearn_linear": {
   "to": "multiple_ols",
   "params": {
    "features": "features",
    "y": "y",
